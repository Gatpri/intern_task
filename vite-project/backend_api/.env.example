# Firebase Admin SDK Credentials
# Copy this file to .env and fill in your actual Firebase credentials
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# DO NOT commit the actual .env file to git!

FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...(your_actual_key_here)...-----END PRIVATE KEY-----\n

# SendGrid API Key (optional - for email functionality)
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# MongoDB Connection
MONGODB_URI=mongodb://admin:password123@localhost:27017/yourdbname

# Server Port
PORT=3000

